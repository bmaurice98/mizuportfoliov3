{
  "name": "mizuportfoliov3",
  "version": "0.1.0",
  "description": "SpacetimeDB TypeScript backend server module",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "spacetimedb-compiler build src/index.ts",
    "generate": "spacetime generate --lang typescript --out-dir ./src/module_bindings --module-path ./spactimedb",
    "publish": "spactime publish mizudevportfolio-db-esdo8 -s maincloud",
    "clear": "spactime publish mizudevportfolio-db-esdo8 -c"
  },
  "dependencies": {
    "spacetimedb": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
